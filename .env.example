# Fudo API
FUDO_API_KEY=tu_api_key
FUDO_API_SECRET=tu_api_secret
FUDO_API_URL=https://api.fu.do/v1
# FUDO_AUTH_URL=https://auth.fu.do/api # Opcional, por defecto auth.fu.do

# Seguridad interna para Cron Handlers
CRON_SECRET=token_secreto_para_proteger_endpoints

# Opcional: Proveedor WhatsApp para envíos desatendidos en segundo plano (ej. Evolution API)
WHATSAPP_API_URL=https://tu-instancia-evolution.com
WHATSAPP_API_TOKEN=tu_token_evolution
WHATSAPP_INSTANCE_NAME=instancia_principal

# Seguridad de acceso (PIN para ingresar a la app)
APP_ACCESS_PIN=1234
